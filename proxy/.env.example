# Zama Relayer API key (mainnet). Set ONLY in Vercel project env / server env. Never in frontend code or git.
ZAMA_RELAYER_API_KEY=
# Comma-separated browser origins allowed to call the proxy
ALLOWED_ORIGINS=https://zamies-x.vercel.app
# Reject requests without an Origin header (non-browser callers). Default true.
REQUIRE_ORIGIN=true
# Chains served (1 = Ethereum mainnet, 11155111 = Sepolia) and which of them get the API key
ENABLED_CHAINS=11155111,1
KEYED_CHAINS=1
# Requests per minute per client IP (fixed window)
RATE_LIMIT_PER_MIN=300
# Optional shared rate limit across serverless instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional overrides
# RELAYER_UPSTREAM_1=https://relayer.mainnet.zama.org/v2
# RELAYER_UPSTREAM_11155111=https://relayer.testnet.zama.org/v2
# MAX_BODY_BYTES=2097152
# UPSTREAM_TIMEOUT_MS=25000
