# Copy to contracts/.env (never commit the real file) and export before running scripts.
# Use a FRESH wallet that holds only Sepolia test ETH. Never use a wallet with real funds.

# Private key of the Sepolia deployer / test wallet (0x-prefixed, 64 hex chars)
ZAMIES_DEPLOYER_KEY=0xYOUR_SEPOLIA_TEST_WALLET_PRIVATE_KEY

# Optional: Sepolia RPC URL (defaults to https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Optional: Zama relayer API key (required on mainnet, not needed on Sepolia)
ZAMA_RELAYER_API_KEY=YOUR_ZAMA_RELAYER_API_KEY
